PORT=5000
MONGODB_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=production
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Reverse Proxy & Rate Limiting (optional overrides)
TRUST_PROXY_HOPS=1
RATE_LIMIT_GLOBAL_AUTH_MAX=1200
RATE_LIMIT_GLOBAL_ANON_MAX=300
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_CHECKOUT_MAX=25
RATE_LIMIT_POLLING_MAX=90
